{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "inject",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inject-production",
      "database_id": "a475780f-e403-42cf-87a5-aa54578a420d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "inject-files"
    }
  ],
  "secrets": {
    "required": ["RESEND_API_KEY"]
  }
}
